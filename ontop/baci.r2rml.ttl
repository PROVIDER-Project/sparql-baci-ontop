    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <https://example.org/baci/structure/HS92_V202601> ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant qb:DataStructureDefinition ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/baci/component/exporter> ] ] ;
