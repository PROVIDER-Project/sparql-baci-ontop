<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.aksw.data.config</groupId>
    <artifactId>aksw-data-deployment</artifactId>
    <version>0.0.8</version>
    <relativePath />
  </parent>
  <groupId>org.aksw.data.baci</groupId>
  <artifactId>baci-hs92-v202601-2024-duckdb</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <name>PROVIDER - BACI HS92 V202601, 2024 only preloaded DuckDB</name>
  <description>
    Zstandard-compressed DuckDB derived from BACI HS92 V202601, 2024 only. Source coordinate:
org.aksw.data.thirdparty.fr.cepii.baci:HS92_V202601:1. Produced by
https://github.com/PROVIDER-Project/sparql-baci-ontop for its Ontop R2RML mappings.
RDF is not materialized. Transformations include typed ingestion, derived lookup
keys and lexical columns, deduplicated code lists, indexes and auditable country
links. Source values and dataset-specific area identities are retained.
Attribution: CEPII BACI V202601 (30 January 2026), HS92, 2024 only. Gaulier and Zignago (2010), BACI: International Trade Database at the Product-Level, CEPII Working Paper 2010-23. Country exclusions are PROVIDER policy, not an official CEPII concordance.
  </description>
  <url>https://github.com/PROVIDER-Project/sparql-baci-ontop</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>PROVIDER Project</name>
    <url>https://github.com/PROVIDER-Project</url>
  </organization>
  <developers>
    <developer>
      <name>Claus Stadler</name>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>Etalab Open Licence 2.0</name>
      <url>https://www.data.gouv.fr/pages/legal/licences/etalab-2.0</url>
      <distribution>repo</distribution>
      <comments>Source attribution and transformation notices must be retained. CEPII data are supplied under Etalab 2.0. This licence covers the derived data artifact, not third-party software.</comments>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/PROVIDER-Project/sparql-baci-ontop.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/PROVIDER-Project/sparql-baci-ontop.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/PROVIDER-Project/sparql-baci-ontop</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/PROVIDER-Project/sparql-baci-ontop/issues</url>
  </issueManagement>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <docker-maven-plugin.version>0.49.0</docker-maven-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <data.repository.url>https://maven.inf-ai.duckdns.org/releases</data.repository.url>
    <source.groupId>org.aksw.data.thirdparty.fr.cepii.baci</source.groupId>
    <duckdb.image>aksw/duckdb-shell:1.5.6</duckdb.image>
    <generator.timeout>7200000</generator.timeout>
    <compressor.base.image>debian:bookworm-slim</compressor.base.image>
    <compressor.image>compress-${project.artifactId}:${project.version}</compressor.image>
    <compressor.timeout>1800000</compressor.timeout>
    <zstd.level>6</zstd.level>
    <zstd.threads>2</zstd.threads>
    <docker.apiVersion>1.44</docker.apiVersion>
    <docker.showLogs>true</docker.showLogs>
    <input.directory>${project.build.directory}/inputs</input.directory>
    <database.filename>baci.duckdb</database.filename>
    <output.filename>${database.filename}.zst</output.filename>
    <output.path>${project.build.directory}/${output.filename}</output.path>
    <source.artifactId>HS92_V202601</source.artifactId>
    <source.version>1</source.version>
    <local.deployment.directory>${project.build.directory}/m2</local.deployment.directory>
  </properties>
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases>
        <enabled>true</enabled>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>aksw-data-releases</id>
      <url>${data.repository.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>maven.aksw.internal</id>
      <url>https://maven.aksw.org/repository/internal/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>maven.aksw.snapshots</id>
      <url>https://maven.aksw.org/repository/snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>maven.aksw.internal</id>
      <url>https://maven.aksw.org/repository/internal/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>maven.aksw.snapshots</id>
      <url>https://maven.aksw.org/repository/snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>${maven-install-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>${maven-deploy-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${build-helper-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-preloaded-database</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${output.path}</file>
                  <type>duckdb.zst</type>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>local</id>
      <properties>
        <maven.install.skip>true</maven.install.skip>
      </properties>
      <distributionManagement>
        <repository>
          <id>baci-local-build</id>
          <url>file://${local.deployment.directory}</url>
        </repository>
        <snapshotRepository>
          <id>baci-local-build</id>
          <url>file://${local.deployment.directory}</url>
        </snapshotRepository>
      </distributionManagement>
    </profile>
    <profile>
      <id>generate-data</id>
      <activation>
        <property>
          <name>skipGenerateData</name>
          <value>!true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <version>${docker-maven-plugin.version}</version>
            <configuration>
              <images>
                <image>
                  <alias>baci-generator</alias>
                  <name>${duckdb.image}</name>
                  <run>
                    <entrypoint>
                      <exec>
                        <arg>/bin/sh</arg>
                        <arg>/opt/loader/load-duckdb.sh</arg>
                      </exec>
                    </entrypoint>
                    <cmd>
                      <exec>
                        <arg>/output/${database.filename}</arg>
                        <arg>/opt/ontop/input/load.sql</arg>
                        <arg>/output/${output.filename}</arg>
                      </exec>
                    </cmd>
                    <volumes>
                      <bind>
                        <volume>${project.build.directory}:/output</volume>
                        <volume>${input.directory}:/data:ro</volume>
                        <volume>${project.basedir}:/opt/ontop/input:ro</volume>
                        <volume>${project.basedir}/loader:/opt/loader:ro</volume>
                      </bind>
                    </volumes>
                    <wait>
                      <time>${generator.timeout}</time>
                      <exit>0</exit>
                    </wait>
                  </run>
                </image>
                <image>
                  <alias>baci-compressor</alias>
                  <name>${compressor.image}</name>
                  <build>
                    <from>${compressor.base.image}</from>
                    <runCmds>
                      <run>apt-get update &amp;&amp; apt-get install -y --no-install-recommends zstd &amp;&amp; rm -rf /var/lib/apt/lists/*</run>
                    </runCmds>
                    <entryPoint>
                      <exec>
                        <arg>/bin/sh</arg>
                        <arg>/opt/compressor/compress-duckdb.sh</arg>
                      </exec>
                    </entryPoint>
                    <cmd>
                      <exec>
                        <arg>/output/${database.filename}</arg>
                        <arg>/output/${output.filename}</arg>
                        <arg>${zstd.level}</arg>
                        <arg>${zstd.threads}</arg>
                      </exec>
                    </cmd>
                  </build>
                  <run>
                    <volumes>
                      <bind>
                        <volume>${project.build.directory}:/output</volume>
                        <volume>${project.basedir}/loader:/opt/compressor:ro</volume>
                      </bind>
                    </volumes>
                    <wait>
                      <time>${compressor.timeout}</time>
                      <exit>0</exit>
                    </wait>
                  </run>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>generate-preloaded-database</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>start</goal>
                </goals>
                <configuration>
                  <filter>baci-generator</filter>
                </configuration>
              </execution>
              <execution>
                <id>compress-preloaded-database</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>build</goal>
                  <goal>start</goal>
                </goals>
                <configuration>
                  <filter>baci-compressor</filter>
                </configuration>
              </execution>
              <execution>
                <id>remove-build-containers</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>resolve-inputs</id>
      <activation>
        <property>
          <name>skipGenerateData</name>
          <value>!true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>resolve-input-snapshots</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <outputDirectory>${input.directory}</outputDirectory>
                  <artifactItems>
                    <artifactItem>
                      <groupId>${source.groupId}</groupId>
                      <artifactId>${source.artifactId}</artifactId>
                      <version>${source.version}</version>
                      <type>csv.zst</type>
                      <classifier>BACI_HS92_Y2024_V202601</classifier>
                      <destFileName>BACI_HS92_Y2024_V202601.csv.zst</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>${source.groupId}</groupId>
                      <artifactId>${source.artifactId}</artifactId>
                      <version>${source.version}</version>
                      <type>csv.zst</type>
                      <classifier>country_codes_V202601</classifier>
                      <destFileName>country_codes_V202601.csv.zst</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>${source.groupId}</groupId>
                      <artifactId>${source.artifactId}</artifactId>
                      <version>${source.version}</version>
                      <type>csv.zst</type>
                      <classifier>product_codes_HS92_V202601</classifier>
                      <destFileName>product_codes_HS92_V202601.csv.zst</destFileName>
                    </artifactItem>
                    <artifactItem>
                      <groupId>${source.groupId}</groupId>
                      <artifactId>${source.artifactId}</artifactId>
                      <version>${source.version}</version>
                      <type>txt</type>
                      <classifier>readme</classifier>
                      <destFileName>Readme.txt</destFileName>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
